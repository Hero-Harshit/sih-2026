# Google Gemini API Key for LLM chat & vector embeddings (gemini-3.5-flash-lite, gemini-3.6-flash, gemini-embedding-001)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL database URL and Service Role or Anon API Key (for pgvector semantic document search)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_api_key_here

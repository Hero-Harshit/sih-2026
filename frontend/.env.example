# URL of the running FastAPI backend (optional if using serverless chat handler, default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Gemini API Key for serverless Next.js AI Assistant (e.g. deployed on Vercel)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Password for protected administrative actions (if applicable)
ADMIN_PASSWORD=123456

